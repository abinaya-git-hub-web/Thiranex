# =============================================================================
# Thiranex Solutions — Production Environment Configuration Template
# Copy this file to .env and populate with your production secrets.
# DO NOT commit .env or secrets to public version control.
# =============================================================================

# Server & Runtime Configuration
PORT=8501
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
ENVIRONMENT=production

# Production Database Connections (Optional)
# PostgreSQL / MySQL / Supabase / Neon / RDS connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/thiranex_db
SQL_CONNECTION_STRING=postgresql://postgres:your_password@localhost:5432/thiranex_db

# MongoDB (NoSQL) Connection (Optional)
MONGODB_URI=mongodb+srv://admin:your_password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=thiranex_db
MONGODB_COLLECTION=enterprise_records

# Directory Watcher Automation Path
WATCH_DIRECTORY=./data_inbox

# REST API Ingestion Endpoint & Authentication (Optional)
REST_API_ENDPOINT=https://api.example.com/v1/telemetry
REST_API_KEY=your_api_key_token_here

# Cloud Storage Integrations (Optional)
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=thiranex-enterprise-data

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=raw-data-inbox

# Google Cloud & Google Sheets
GOOGLE_SHEETS_API_KEY=your_google_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
